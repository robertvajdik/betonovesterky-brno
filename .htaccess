Options -Indexes
AddDefaultCharset UTF-8

# Vlastní stránka 404 i pro chybějící soubory (v podadresáři: ErrorDocument 404 /betonovesterky/404.php)
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Produkce: vše na https://betonovesterky-brno.cz (http → https, www → bez www), 301
  RewriteCond %{HTTP_HOST} betonovesterky-brno\.cz$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{THE_REQUEST} \s/+(?:domains/[^/]+/?)?(\S*)\s [NC]
  RewriteRule ^ https://betonovesterky-brno.cz/%1 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^www\.betonovesterky-brno\.cz$ [NC]
  RewriteCond %{THE_REQUEST} \s/+(?:domains/[^/]+/?)?(\S*)\s [NC]
  RewriteRule ^ https://betonovesterky-brno.cz/%1 [R=301,L,NE]
  # Pozn.: %{REQUEST_URI} na tomto hostingu obsahuje interní cestu /domains/…, proto cesta z THE_REQUEST (jeden 301 skok)
  # staré odkazy s interní cestou hostingu (/domains/betonovesterky-brno.cz/…)
  RewriteCond %{THE_REQUEST} \s/+domains/[^/]+(/\S*)?\s [NC]
  RewriteRule ^ https://betonovesterky-brno.cz%1 [R=301,L,NE]

  # Pokud je web v podadresáři, nastavte např.: RewriteBase /betonovesterky/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Zákaz přímého přístupu k interním souborům
<FilesMatch "^(config\.php|.*\.sql|README\.md)$">
  Require all denied
</FilesMatch>
